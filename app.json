{
  "expo": {
    "name": "Bible Tabs",
    "slug": "EsvBible",
    "version": "5.1.0",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ashtonsprunger.bibletabs"
    },
    "android": {
      "package": "ashtonsprunger.bibletabs",
      "versionCode": 26,
      "predictiveBackGestureEnabled": true,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/foreground.png",
        "backgroundColor": "#E2F5FF"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-screen-orientation",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "f59841a3-82e5-4327-9ca1-9d1f3d73acd0"
      }
    }
  }
}

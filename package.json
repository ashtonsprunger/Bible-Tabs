{
  "name": "bible-tabs",
  "version": "5.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:db": "node --experimental-sqlite scripts/build-bible-db.mjs bsb",
    "build:dbs": "node --experimental-sqlite scripts/build-bible-db.mjs",
    "build:web": "expo export --platform web && node scripts/sync-web-site.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.33",
    "expo-asset": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.24",
    "expo-haptics": "~57.0.3",
    "expo-navigation-bar": "~57.0.3",
    "expo-screen-orientation": "~57.0.3",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.1.0"
